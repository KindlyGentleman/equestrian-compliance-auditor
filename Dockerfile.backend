# ==============================================================================
# Multi-Stage Production Dockerfile for Equestrian Compliance Backend
# ==============================================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build tools and OS libraries for PyMuPDF & RapidOCR ONNX Runtime
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir .

# ==============================================================================
# Production Runtime Stage
# ==============================================================================
FROM python:3.12-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install --no-install-recommends -y \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create non-root user for security best practice
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/storage /app/backend/storage && \
    chown -R appuser:appuser /app

# Copy application source and rules catalog
COPY --chown=appuser:appuser backend/ /app/backend/
COPY --chown=appuser:appuser pyproject.toml /app/

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
