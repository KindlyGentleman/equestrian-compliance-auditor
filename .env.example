# ==============================================================================
# Equestrian Compliance & Specification Auditor - Environment Configuration
# ==============================================================================

# Application General
APP_NAME="Equestrian Compliance & Specification Auditor"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Google Gemini API
# Required for semantic compliance reasoning (Gemini 2.0 Flash) and text embeddings.
# Leave empty or set USE_MOCK_LLM=true for offline / CI testing.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
USE_MOCK_LLM=false

# Local Storage & Vector DB Paths
QDRANT_STORAGE_PATH="./storage/qdrant"
QDRANT_COLLECTION_NAME="equestrian_regulations"
UPLOAD_DIR="./storage/uploads"
CACHE_DIR="./storage/cache"
FIGURE_EXPORT_DIR="./storage/figures"

# Regulatory Knowledge Base
REGULATIONS_DIR="./backend/app/data/regulations"
RULES_CATALOG_PATH="./backend/app/data/rules_catalog.json"
