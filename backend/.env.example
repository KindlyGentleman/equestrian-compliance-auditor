# ==============================================================================
# Equestrian Compliance & Specification Auditor - Environment Variables
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector Database (Qdrant) Configuration
# By default, runs in local embedded mode storing data to disk under backend/storage/qdrant
QDRANT_STORAGE_PATH=./backend/storage/qdrant
QDRANT_COLLECTION_NAME=equestrian_regulations

# Storage Paths
UPLOAD_DIR=./backend/storage/uploads
CACHE_DIR=./backend/storage/cache
FIGURE_EXPORT_DIR=./backend/storage/figures
